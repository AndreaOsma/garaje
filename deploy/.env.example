# Copia a .env (en este mismo directorio) y ajusta lo que necesites. Todo es opcional.

# Puerto en el host.
GARAJE_HTTP_PORT=8080
# 127.0.0.1 = solo este equipo. 0.0.0.0 solo con un proxy con login o una VPN delante.
GARAJE_BIND=127.0.0.1
# Zona horaria de las grabaciones de Car Scanner (vienen en hora local).
GARAJE_TZ=Europe/Madrid
# IA del servidor para investigar códigos de avería (también se puede elegir en Ajustes).
GARAJE_ANTHROPIC_API_KEY=
GARAJE_OLLAMA_URL=
GARAJE_OLLAMA_MODEL=
