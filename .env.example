# Copia este archivo a .env para desarrollo local.

# URL de la base de datos SQLite. Vacío = ./test.db junto al backend.
# DATABASE_URL=sqlite:///./test.db

# Orígenes permitidos por CORS en dev (separados por coma). No hace falta en Docker/desktop
# (mismo origen: el propio backend sirve el frontend).
# CORS_ALLOW_ORIGINS=http://localhost:5173

PORT=8080
